# Copy to .env.local (which is gitignored) and fill in.
# Never commit real keys.

# Origin used to build shop/product links, canonical URLs and OG metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# `supabase` (alias: postgres) uses Supabase Postgres. `sqlite` uses a local file.
# If unset: production uses Supabase, development/tests use SQLite.
DATA_BACKEND=supabase

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL — Settings → API → Project URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public "anon" key — safe to ship to the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-side only. Used for Storage uploads and downloads.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the application and the migration runner.
# Settings → Database → Connection string → URI.
# On Vercel prefer the pooler host (IPv4) and port 6543 (transaction mode).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional: Postgres pool size per serverless instance (default 5).
PG_POOL_MAX=5

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------

# `supabase` uses Supabase Storage (required in production). `local` writes to
# `data/uploads` and is for development only.
STORAGE_BACKEND=supabase

# ---------------------------------------------------------------------------
# Paystack (seller subscriptions)
# ---------------------------------------------------------------------------

# Secret key from the Paystack dashboard. Server-side only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Monthly plan price in kobo (250000 = N2,500). Sellers get one free month first.
SELLER_PLAN_KOBO=250000
