{
  "name": "orderpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --import ./scripts/register.mjs scripts/seed.mjs",
    "db:reset": "node --import ./scripts/register.mjs scripts/reset.mjs",
    "db:prune": "node --import ./scripts/register.mjs scripts/prune.mjs",
    "db:supabase": "node --import ./scripts/register.mjs scripts/supabase-migrate.mjs",
    "db:check": "node --import ./scripts/register.mjs scripts/supabase-check.mjs",
    "acceptance": "node --import ./scripts/register.mjs scripts/acceptance.mjs",
    "test": "node --import ./scripts/register-tests.mjs --test --test-isolation=none --test-concurrency=1 tests/*.test.mjs",
    "db:sync": "node --import ./scripts/register.mjs scripts/sync-supabase.mjs",
    "db:sync:watch": "node --import ./scripts/register.mjs scripts/sync-supabase.mjs --watch"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.4",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  }
}
